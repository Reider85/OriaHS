{
  "dashboard": {
    "id": null,
    "title": "MVP — Search Latency",
    "tags": ["mvp", "search", "latency"],
    "timezone": "browser",
    "panels": [
      {
        "id": 1,
        "title": "Latency Percentiles",
        "type": "stat",
        "targets": [
          {
            "expr": "histogram_quantile(0.50, rate(search_latency_ms_bucket[5m]))",
            "legendFormat": "p50"
          },
          {
            "expr": "histogram_quantile(0.95, rate(search_latency_ms_bucket[5m]))",
            "legendFormat": "p95"
          },
          {
            "expr": "histogram_quantile(0.99, rate(search_latency_ms_bucket[5m]))",
            "legendFormat": "p99"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "mappings": [],
            "thresholds": {
              "steps": [
                {
                  "color": "green",
                  "value": 0
                },
                {
                  "color": "yellow",
                  "value": 100
                },
                {
                  "color": "red",
                  "value": 200
                }
              ]
            },
            "unit": "ms"
          }
        }
      },
      {
        "id": 2,
        "title": "Latency Heatmap",
        "type": "heatmap",
        "targets": [
          {
            "expr": "sum(rate(search_latency_ms_bucket[5m])) by (le)",
            "legendFormat": "{{le}}ms"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "spectrum",
              "fixed": {
                "color": "green",
                "alpha": 1
              },
              "scale": "linear"
            },
            "thresholds": {
              "steps": [
                {
                  "color": "green",
                  "value": 0
                },
                {
                  "color": "yellow",
                  "value": 50
                },
                {
                  "color": "red",
                  "value": 200
                }
              ]
            }
          }
        }
      },
      {
        "id": 3,
        "title": "Latency by Tenant",
        "type": "stat",
        "targets": [
          {
            "expr": "histogram_quantile(0.99, rate(search_latency_ms_bucket{tenant_id!=\"\"}[5m])) by (tenant_id)",
            "legendFormat": "{{tenant_id}}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "mappings": [],
            "thresholds": {
              "steps": [
                {
                  "color": "green",
                  "value": 0
                },
                {
                  "color": "yellow",
                  "value": 100
                },
                {
                  "color": "red",
                  "value": 200
                }
              ]
            },
            "unit": "ms"
          }
        }
      },
      {
        "id": 4,
        "title": "Embedding Cache Hit Rate",
        "type": "stat",
        "targets": [
          {
            "expr": "rate(embedding_cache_hits_total[5m]) / rate(embedding_cache_requests_total[5m]) * 100",
            "legendFormat": "Cache hit rate"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "mappings": [],
            "thresholds": {
              "steps": [
                {
                  "color": "green",
                  "value": 0
                },
                {
                  "color": "yellow",
                  "value": 70
                },
                {
                  "color": "green",
                  "value": 90
                }
              ]
            },
            "unit": "percentunit"
          }
        }
      }
    ],
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "refresh": "30s"
  }
}