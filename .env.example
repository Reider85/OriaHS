# ===== Infra ports =====
# NOTE: host port 5432 may be taken by a locally-installed PostgreSQL;
# use 5433 to avoid conflicts on dev machines.
POSTGRES_PORT=5433
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
REDIS_PORT=6379
API_PORT=8000
API_WORKERS=1
# Prometheus (C-12/C-13) — источник данных для всех дашбордов Grafana.
PROMETHEUS_PORT=9090
PROMETHEUS_RETENTION_TIME=7d
GRAFANA_PORT=3000
GRAFANA_PASSWORD=admin

# ===== Container image =====
# Тег общего образа для api / reconciler / digest / one-shot jobs.
APP_IMAGE=oriahs:dev
# Число «фейковых» документов, которое добавляет seed-eval помимо документов
# из eval-датасета (нужно для непустой выборки push-down фильтров, C-10).
SEED_FILLER_DOCS=200

# ===== PostgreSQL =====
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=orlahs
POSTGRES_HOST=localhost
# SQLAlchemy async DSN (auto-built from parts above in app/config.py)
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/orlahs

# ===== Qdrant =====
QDRANT_URL=http://localhost:6333
QDRANT_GRPC_URL=grpc://localhost:6334
QDRANT_COLLECTION=documents
QDRANT_API_KEY=
# qdrant_collections.yaml рассчитан на кластер (replication_factor=2), но
# dev-стек — один узел: без override коллекция не создаётся.
QDRANT_REPLICATION_FACTOR=1

# ===== Redis =====
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_POOL_SIZE=10

# ===== Application =====
APP_NAME=OriaHS
ENVIRONMENT=dev
LOG_LEVEL=INFO
DEBUG=true

# ===== Embedding (ARCHITECT §17.2) =====
EMBEDDING_MODEL_NAME=bge-m3-v1
EMBEDDING_BATCH_SIZE=32
EMBEDDING_MAX_LENGTH=512
EMBEDDING_CACHE_TTL_SECONDS=2592000
EMBEDDING_DEVICE=auto

# ===== Search (ARCHITECT §17.2) =====
SEARCH_K_LEXICAL=50
SEARCH_K_VECTOR=50
SEARCH_K_RERANK=50
SEARCH_K_FINAL=20
SEARCH_DEFAULT_FUSION=rrf
SEARCH_RRF_K=60
SEARCH_WEIGHTED_ALPHA=0.5

# ===== Reconciler (ARCHITECT §17.2) =====
RECONCILER_POLL_INTERVAL_SECONDS=30
RECONCILER_BATCH_SIZE=500
RECONCILER_MAX_ATTEMPTS=20
RECONCILER_BASE_BACKOFF_SECONDS=10
RECONCILER_MAX_BACKOFF_SECONDS=3600
RECONCILER_DIGEST_INTERVAL_MINUTES=60

# ===== Observability =====
METRICS_PATH=/metrics

# ===== Reranker (Critical phase) =====
RERANKER_MODEL_NAME=BAAI/bge-reranker-v2-m3
RERANKER_BATCH_SIZE=32
RERANKER_MAX_LENGTH=512
RERANKER_DEVICE=auto
RERANKER_MOCK_MODE=false
RERANKER_TIMEOUT_MS=500
RERANKER_SPECULATIVE_TOP_N=10
RERANKER_SPECULATIVE_ENABLED=true
# Прогрев cross-encoder при старте API: снимает первый запрос «в лоб»,
# но требует скачанной модели (BAAI/bge-reranker-v2-m3) в HF_HOME.
RERANKER_WARMUP=false

# ===== HuggingFace cache =====
# Хостовый запуск (uvicorn локально). В контейнере переопределяется на
# /cache/huggingface — именованный том hf_cache, переживает пересборку.
HF_HOME=.cache/huggingface

# ===== Circuit Breaker (Critical phase) =====
CIRCUIT_BREAKER_ERROR_RATE_THRESHOLD=0.05
CIRCUIT_BREAKER_LATENCY_P95_THRESHOLD_MS=500
CIRCUIT_BREAKER_WINDOW_SECONDS=60
CIRCUIT_BREAKER_COOLDOWN_SECONDS=60

# ===== Offline Evaluation (Critical phase) =====
EVAL_DATASET_PATH=eval/datasets/baseline_v1.jsonl
EVAL_BASELINES_DIR=eval/baselines/
EVAL_RECALL_REGRESSION_THRESHOLD=0.02
EVAL_NDCG_REGRESSION_THRESHOLD=0.01
EVAL_CRON=0 2 * * *

# ===== Push-down Filters (Critical phase) =====
PUSHDOWN_SELECTIVITY_THRESHOLD=0.1
PUSHDOWN_MAX_CANDIDATE_IDS=5000

# ===== Throttling (Critical phase) =====
THROTTLE_PENDING_WARN_THRESHOLD=50000
THROTTLE_PENDING_REINDEX_THRESHOLD=100000

# ===== Feature Flags (Critical phase) =====
VECTOR_SEARCH_ENABLED=true
RERANK_ENABLED=true
WEIGHTED_FUSION_ENABLED=true
PUSHDOWN_ENABLED=true
THROTTLE_ENABLED=true

# ===== Feature Flags (Production-Ready phase) =====
PERSONALIZATION_ENABLED=true
AB_TESTING_ENABLED=true
DIVERSIFY_ENABLED=true
CONTEXT_PERSONALIZATION_ENABLED=true
TRACING_ENABLED=true
MIGRATION_FRAMEWORK_ENABLED=false
SHADOW_TRAFFIC_ENABLED=false
ADAPTIVE_K_ENABLED=true
INCREMENTAL_FACETS_ENABLED=true
NEGATIVE_CACHE_ENABLED=true
ASYMMETRIC_INDEXING_ENABLED=true

# ===== Personalization =====
PERSONALIZATION_EMA_ALPHA_NEW=0.5
PERSONALIZATION_EMA_ALPHA_ESTABLISHED=0.05
PERSONALIZATION_NEW_USER_CLICK_THRESHOLD=10
PERSONALIZATION_PROFILE_WEIGHT=0.3
PERSONALIZATION_FUSED_WEIGHT=0.7
PERSONALIZATION_COLD_START_ENABLED=true
PERSONALIZATION_PROFILE_DIMENSION=1024
PERSONALIZATION_GDPR_DELETE_ENDPOINT_ENABLED=true

# ===== A/B Testing =====
AB_TESTING_STICKY_HASH_BUCKETS=1000
AB_TESTING_SEQUENTIAL_TESTING_ENABLED=true
AB_TESTING_SIGNIFICANCE_LEVEL=0.05
AB_TESTING_MIN_SAMPLES_PER_VARIANT=100
AB_TESTING_MAX_PARALLEL_EXPERIMENTS=3

# ===== Tracing =====
TRACING_OTEL_ENDPOINT=http://otel-collector:4317
TRACING_SERVICE_NAME=oriahs
TRACING_EXPORT_INTERVAL_MS=5000
TRACING_SAMPLE_RATE=1.0

# ===== Migration =====
MIGRATION_BACKFILL_BATCH_SIZE=1000
MIGRATION_BACKFILL_SPEED_DOC_PER_HOUR=50000
MIGRATION_CANARY_PERCENTAGE=0.01
MIGRATION_CANARY_MIN_SIMILARITY=0.6
MIGRATION_CANARY_MAX_SIMILARITY=0.95
MIGRATION_SNAPSHOT_RETENTION_DAYS=30
MIGRATION_SNAPSHOT_S3_BUCKET=oriahs-qdrant-snapshots
MIGRATION_ROLLBACK_TIMEOUT_MINUTES=30

# ===== Shadow Traffic =====
SHADOW_TRAFFIC_ENABLED=false
SHADOW_TRAFFIC_STRATEGIES=[]
SHADOW_TRAFFIC_LOG_VARIANT=true

# ===== Chaos Engineering =====
CHAOS_SCHEDULE_CRON="0 6 * * 0"
CHAOS_ENVIRONMENT=staging
CHAOS_QDRANT_KILL_SECONDS=60
CHAOS_RERANKER_DELAY_MS=1000
CHAOS_REDIS_FILL_PERCENTAGE=0.95

# ===== Adaptive K =====
ADAPTIVE_K_SMALL_TENANT_DOC_THRESHOLD=10000
ADAPTIVE_K_LARGE_TENANT_DOC_THRESHOLD=1000000
ADAPTIVE_K_SHORT_QUERY_LEN_THRESHOLD=5
ADAPTIVE_K_LONG_QUERY_LEN_THRESHOLD=20
ADAPTIVE_K_SMALL=30
ADAPTIVE_K_LARGE=100

# ===== Search Events =====
SEARCH_EVENTS_S3_ENDPOINT_URL=http://minio:9000
SEARCH_EVENTS_S3_BUCKET=oriahs-search-events-archive
SEARCH_EVENTS_S3_ACCESS_KEY=minioadmin
SEARCH_EVENTS_S3_SECRET_KEY=minioadmin
SEARCH_EVENTS_RETENTION_DAYS=90
SEARCH_EVENTS_PARTITION_AHEAD_DAYS=7
SEARCH_EVENTS_MIGRATION_PARTITION_DAYS=30
SEARCH_EVENTS_HASH_QUERY_TEXT=false
SEARCH_EVENTS_CLICK_STATEMENT_TIMEOUT_MS=100

# ===== Incremental Facets =====
INCREMENTAL_FACETS_CACHE_TTL_SECONDS=600
INCREMENTAL_FACETS_CACHE_KEY_PREFIX=facets

# ===== Negative Cache =====
NEGATIVE_CACHE_NULL_TTL_SECONDS=60
NEGATIVE_CACHE_ENABLED=true

# ===== MMR Diversification (PR-04) =====
# Default λ: 0.7 = 70% relevance / 30% diversity.
MMR_DEFAULT_LAMBDA=0.7
# Adaptive λ: lower λ automatically when the top-K diversity score is low.
MMR_ADAPTIVE_ENABLED=true
# Diversity score below which adaptive λ kicks in.
MMR_DIVERSITY_THRESHOLD=0.3
# Decrement applied to λ per adaptive iteration.
MMR_LAMBDA_STEP=0.1
# Floor for λ (1-λ = 0.5 max diversity weight).
MMR_MIN_LAMBDA=0.5