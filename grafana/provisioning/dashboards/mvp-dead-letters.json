{
  "dashboard": {
    "id": null,
    "title": "MVP — Dead Letters",
    "tags": ["mvp", "dead", "letters"],
    "timezone": "browser",
    "panels": [
      {
        "id": 1,
        "title": "Dead Count Over Time",
        "type": "timeseries",
        "targets": [
          {
            "expr": "dead_letter_count",
            "legendFormat": "Dead letters"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "thresholds"
            },
            "mappings": [],
            "thresholds": {
              "steps": [
                {
                  "color": "green",
                  "value": 0
                },
                {
                  "color": "yellow",
                  "value": 1
                },
                {
                  "color": "red",
                  "value": 10
                }
              ]
            },
            "unit": "none"
          }
        }
      },
      {
        "id": 2,
        "title": "Dead Letters by Tenant",
        "type": "table",
        "targets": [
          {
            "rawSql": "SELECT tenant_id, model_name, error_type, count, last_seen_at FROM search_outbox_dead_digest ORDER BY last_seen_at DESC LIMIT 100",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "mappings": [],
            "thresholds": {
              "steps": [
                {
                  "color": "green",
                  "value": 0
                },
                {
                  "color": "yellow",
                  "value": 5
                },
                {
                  "color": "red",
                  "value": 20
                }
              ]
            },
            "custom": {
              "align": null,
              "filterable": true
            }
          },
          "overrides": [
            {
              "matcher": {
                "id": "byName",
                "options": "count"
              },
              "properties": [
                {
                  "id": "unit",
                  "value": "none"
                }
              ]
            },
            {
              "matcher": {
                "id": "byName",
                "options": "last_seen_at"
              },
              "properties": [
                {
                  "id": "custom.width",
                  "value": 150
                }
              ]
            }
          ]
        }
      },
      {
        "id": 3,
        "title": "Sample Errors",
        "type": "table",
        "targets": [
          {
            "rawSql": "SELECT tenant_id, model_name, error_type, count, sample_errors FROM search_outbox_dead_digest WHERE array_length(sample_errors, 1) > 0 ORDER BY last_seen_at DESC LIMIT 100",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "mappings": [],
            "thresholds": {
              "steps": [
                {
                  "color": "green",
                  "value": 0
                },
                {
                  "color": "yellow",
                  "value": 5
                },
                {
                  "color": "red",
                  "value": 20
                }
              ]
            },
            "custom": {
              "align": null,
              "filterable": true
            }
          },
          "overrides": [
            {
              "matcher": {
                "id": "byName",
                "options": "count"
              },
              "properties": [
                {
                  "id": "unit",
                  "value": "none"
                }
              ]
            },
            {
              "matcher": {
                "id": "byName",
                "options": "sample_errors"
              },
              "properties": [
                {
                  "id": "custom.width",
                  "value": 300
                }
              ]
            }
          ]
        }
      },
      {
        "id": 4,
        "title": "Alert: Dead Count > 0",
        "type": "alertlist",
        "targets": [
          {
            "expr": "dead_letter_count > 0",
            "legendFormat": "Dead letters detected"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "thresholds"
            },
            "mappings": [],
            "thresholds": {
              "steps": [
                {
                  "color": "red",
                  "value": 0
                },
                {
                  "color": "green",
                  "value": 1
                }
              ]
            },
            "custom": {
              "frameOpacity": 100
            }
          }
        },
        "gridPos": {
          "h": 4,
          "w": 12,
          "x": 0,
          "y": 3
        }
      }
    ],
    "time": {
      "from": "now-6h",
      "to": "now"
    },
    "refresh": "30s"
  }
}