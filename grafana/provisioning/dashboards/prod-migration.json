{
  "dashboard": {
    "id": null,
    "uid": "prod-migration",
    "title": "Prod | Migration Framework",
    "tags": ["prod", "migration"],
    "timezone": "browser",
    "schemaVersion": 39,
    "templating": {
      "list": [
        {
          "name": "DS_PROMETHEUS",
          "label": "Prometheus",
          "type": "datasource",
          "query": "prometheus",
          "current": {},
          "hide": 0,
          "refresh": 1
        }
      ]
    },
    "panels": [
      {
        "id": 1,
        "title": "Active Migrations",
        "type": "stat",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "targets": [
          {
            "expr": "count(count by (migration_id) (migration_backfill_progress > 0))",
            "legendFormat": "Active"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "none",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "green", "value": null },
                { "color": "yellow", "value": 1 },
                { "color": "red", "value": 3 }
              ]
            }
          },
          "overrides": []
        },
        "gridPos": { "h": 8, "w": 8, "x": 0, "y": 0 }
      },
      {
        "id": 2,
        "title": "Backfill Progress",
        "type": "timeseries",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "targets": [
          {
            "expr": "migration_backfill_progress",
            "legendFormat": "{{migration_id}}",
            "instant": false
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "min": 0,
            "max": 100,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "red", "value": 0 },
                { "color": "yellow", "value": 50 },
                { "color": "green", "value": 100 }
              ]
            }
          },
          "overrides": []
        },
        "gridPos": { "h": 8, "w": 16, "x": 8, "y": 0 }
      },
      {
        "id": 3,
        "title": "Backfill Speed (docs/hour)",
        "type": "timeseries",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "targets": [
          {
            "expr": "migration_backfill_speed",
            "legendFormat": "{{migration_id}}",
            "instant": false
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "doc/h",
            "min": 0,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "green", "value": null }
              ]
            }
          },
          "overrides": []
        },
        "gridPos": { "h": 8, "w": 8, "x": 0, "y": 8 }
      },
      {
        "id": 4,
        "title": "Canary Similarity",
        "type": "timeseries",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "targets": [
          {
            "expr": "migration_canary_similarity{kind=\"avg\"}",
            "legendFormat": "{{migration_id}} (avg)",
            "instant": false
          },
          {
            "expr": "migration_canary_similarity{kind=\"min\"}",
            "legendFormat": "{{migration_id}} (min)",
            "instant": false
          },
          {
            "expr": "migration_canary_similarity{kind=\"max\"}",
            "legendFormat": "{{migration_id}} (max)",
            "instant": false
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "none",
            "min": 0,
            "max": 1,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "red", "value": 0 },
                { "color": "yellow", "value": 0.6 },
                { "color": "green", "value": 0.95 },
                { "color": "red", "value": 1 }
              ]
            }
          },
          "overrides": []
        },
        "gridPos": { "h": 8, "w": 16, "x": 8, "y": 8 }
      },
      {
        "id": 5,
        "title": "Snapshots Created",
        "type": "stat",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "targets": [
          {
            "expr": "sum(increase(migration_snapshots_created_total[24h]))",
            "legendFormat": "Last 24h"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "none",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "green", "value": null },
                { "color": "yellow", "value": 5 },
                { "color": "red", "value": 10 }
              ]
            }
          },
          "overrides": []
        },
        "gridPos": { "h": 8, "w": 8, "x": 0, "y": 16 }
      },
      {
        "id": 6,
        "title": "Rollbacks",
        "type": "stat",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "targets": [
          {
            "expr": "sum(increase(migration_rollbacks_total[24h]))",
            "legendFormat": "Last 24h"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "none",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "green", "value": null },
                { "color": "yellow", "value": 1 },
                { "color": "red", "value": 3 }
              ]
            }
          },
          "overrides": []
        },
        "gridPos": { "h": 8, "w": 8, "x": 8, "y": 16 }
      },
      {
        "id": 7,
        "title": "Migration Status Distribution",
        "type": "piechart",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "targets": [
          {
            "expr": "sum by (status) (count by (migration_id, status) (migration_backfill_progress > 0))",
            "legendFormat": "{{status}}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "none",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "green", "value": null }
              ]
            }
          },
          "overrides": []
        },
        "gridPos": { "h": 8, "w": 8, "x": 16, "y": 16 }
      },
      {
        "id": 8,
        "title": "Migration Timeline",
        "type": "table",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "targets": [
          {
            "expr": "migration_backfill_progress",
            "legendFormat": "{{migration_id}}",
            "instant": true
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "min": 0,
            "max": 100,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "red", "value": 0 },
                { "color": "yellow", "value": 50 },
                { "color": "green", "value": 100 }
              ]
            }
          },
          "overrides": []
        },
        "gridPos": { "h": 8, "w": 24, "x": 0, "y": 24 },
        "transformations": [
          {
            "id": "organize",
            "options": {
              "excludeByName": {
                "Time": true,
                "Value": true
              },
              "includeByName": {
                "migration_id": true,
                "Value": true
              },
              "renameByName": {
                "Value": "Progress (%)"
              }
            }
          }
        ]
      }
    ]
  }
}