{
  "dashboard": {
    "id": null,
    "uid": "critical-circuit-breaker",
    "title": "Critical — Circuit Breaker & Throttle",
    "tags": ["critical", "circuit-breaker"],
    "timezone": "browser",
    "schemaVersion": 39,
    "templating": {
      "list": [
        {
          "name": "DS_PROMETHEUS",
          "label": "Prometheus",
          "type": "datasource",
          "query": "prometheus",
          "current": {},
          "hide": 0,
          "refresh": 1
        }
      ]
    },
    "panels": [
      {
        "id": 1,
        "title": "Circuit Breaker State",
        "type": "timeseries",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "targets": [
          {
            "expr": "circuit_breaker_state{component=\"reranker\"}",
            "legendFormat": "State"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "mappings": [
              {
                "type": "value",
                "options": {
                  "match": "0",
                  "result": {
                    "text": "Closed"
                  }
                },
                "id": "1"
              },
              {
                "type": "value",
                "options": {
                  "match": "1",
                  "result": {
                    "text": "Half-Open"
                  }
                },
                "id": "2"
              },
              {
                "type": "value",
                "options": {
                  "match": "2",
                  "result": {
                    "text": "Open"
                  }
                },
                "id": "3"
              }
            ],
            "thresholds": {
              "steps": [
                {
                  "color": "green",
                  "value": 0
                },
                {
                  "color": "yellow",
                  "value": 0.5
                },
                {
                  "color": "red",
                  "value": 1.5
                }
              ]
            },
            "unit": "none"
          }
        }
      },
      {
        "id": 2,
        "title": "Open Events",
        "type": "stat",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "targets": [
          {
            "expr": "rate(circuit_breaker_opened_total[1h])",
            "legendFormat": "Open events per hour"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "mappings": [],
            "thresholds": {
              "steps": [
                {
                  "color": "green",
                  "value": 0
                },
                {
                  "color": "yellow",
                  "value": 1
                },
                {
                  "color": "red",
                  "value": 10
                }
              ]
            },
            "unit": "1/h"
          }
        }
      },
      {
        "id": 3,
        "title": "Outbox Pending Count",
        "type": "stat",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "targets": [
          {
            "expr": "outbox_pending_count",
            "legendFormat": "Pending items"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "mappings": [],
            "thresholds": {
              "steps": [
                {
                  "color": "green",
                  "value": 0
                },
                {
                  "color": "yellow",
                  "value": 50000
                },
                {
                  "color": "red",
                  "value": 100000
                }
              ]
            },
            "unit": "none"
          }
        }
      },
      {
        "id": 4,
        "title": "Throttle Rate",
        "type": "stat",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "targets": [
          {
            "expr": "rate(outbox_throttled_total[5m])",
            "legendFormat": "Throttled requests"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "mappings": [],
            "thresholds": {
              "steps": [
                {
                  "color": "green",
                  "value": 0
                },
                {
                  "color": "yellow",
                  "value": 1
                },
                {
                  "color": "red",
                  "value": 10
                }
              ]
            },
            "unit": "1/s"
          }
        }
      }
    ],
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "refresh": "30s"
  }
}