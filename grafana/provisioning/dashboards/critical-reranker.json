{
  "dashboard": {
    "id": null,
    "title": "Critical — Reranker",
    "tags": ["critical", "reranker"],
    "timezone": "browser",
    "panels": [
      {
        "id": 1,
        "title": "Reranker Latency p50/p95/p99",
        "type": "stat",
        "targets": [
          {
            "expr": "histogram_quantile(0.5, rate(reranker_latency_ms_bucket[5m]))",
            "legendFormat": "p50"
          },
          {
            "expr": "histogram_quantile(0.95, rate(reranker_latency_ms_bucket[5m]))",
            "legendFormat": "p95"
          },
          {
            "expr": "histogram_quantile(0.99, rate(reranker_latency_ms_bucket[5m]))",
            "legendFormat": "p99"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "mappings": [],
            "thresholds": {
              "steps": [
                {
                  "color": "green",
                  "value": 0
                },
                {
                  "color": "yellow",
                  "value": 200
                },
                {
                  "color": "red",
                  "value": 350
                }
              ]
            },
            "unit": "ms"
          }
        }
      },
      {
        "id": 2,
        "title": "Circuit Breaker State",
        "type": "stat",
        "targets": [
          {
            "expr": "circuit_breaker_state{component=\"reranker\"}",
            "legendFormat": "State"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "mappings": [
              {
                "type": "value",
                "options": {
                  "match": "0",
                  "result": {
                    "text": "Closed"
                  }
                },
                "id": "1"
              },
              {
                "type": "value",
                "options": {
                  "match": "1",
                  "result": {
                    "text": "Half-Open"
                  }
                },
                "id": "2"
              },
              {
                "type": "value",
                "options": {
                  "match": "2",
                  "result": {
                    "text": "Open"
                  }
                },
                "id": "3"
              }
            ],
            "thresholds": {
              "steps": [
                {
                  "color": "green",
                  "value": 0
                },
                {
                  "color": "yellow",
                  "value": 0.5
                },
                {
                  "color": "red",
                  "value": 1.5
                }
              ]
            },
            "unit": "none"
          }
        }
      },
      {
        "id": 3,
        "title": "Mock Mode Indicator",
        "type": "stat",
        "targets": [
          {
            "expr": "rate(reranker_latency_ms_bucket{mock=\"true\"}[5m])",
            "legendFormat": "Mock requests"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "mappings": [],
            "thresholds": {
              "steps": [
                {
                  "color": "green",
                  "value": 0
                },
                {
                  "color": "yellow",
                  "value": 1
                },
                {
                  "color": "red",
                  "value": 10
                }
              ]
            },
            "unit": "req/s"
          }
        }
      },
      {
        "id": 4,
        "title": "Reranker Throughput",
        "type": "stat",
        "targets": [
          {
            "expr": "rate(circuit_breaker_requests_total{component=\"reranker\",result=\"success\"}[5m])",
            "legendFormat": "Successful rerank requests"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "mappings": [],
            "thresholds": {
              "steps": [
                {
                  "color": "green",
                  "value": 0
                },
                {
                  "color": "yellow",
                  "value": 10
                },
                {
                  "color": "red",
                  "value": 100
                }
              ]
            },
            "unit": "req/s"
          }
        }
      }
    ],
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "refresh": "30s"
  }
}