{
  "dashboard": {
    "id": null,
    "uid": "critical-pushdown",
    "title": "Critical — Push-down",
    "tags": ["critical", "pushdown"],
    "timezone": "browser",
    "schemaVersion": 39,
    "templating": {
      "list": [
        {
          "name": "DS_PROMETHEUS",
          "label": "Prometheus",
          "type": "datasource",
          "query": "prometheus",
          "current": {},
          "hide": 0,
          "refresh": 1
        }
      ]
    },
    "panels": [
      {
        "id": 1,
        "title": "Push-down Usage Rate",
        "type": "stat",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "targets": [
          {
            "expr": "rate(qdrant_pushdown_rate_total{result=\"used\"}[5m]) / rate(qdrant_pushdown_rate_total[5m]) * 100",
            "legendFormat": "Usage rate (%)"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "mappings": [],
            "thresholds": {
              "steps": [
                {
                  "color": "green",
                  "value": 0
                },
                {
                  "color": "yellow",
                  "value": 20
                },
                {
                  "color": "red",
                  "value": 80
                }
              ]
            },
            "unit": "percentunit"
          }
        }
      },
      {
        "id": 2,
        "title": "Selectivity Gauge",
        "type": "stat",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "targets": [
          {
            "expr": "pushdown_selectivity",
            "legendFormat": "Last selectivity estimate"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "mappings": [],
            "thresholds": {
              "steps": [
                {
                  "color": "red",
                  "value": 0
                },
                {
                  "color": "yellow",
                  "value": 0.1
                },
                {
                  "color": "green",
                  "value": 0.5
                }
              ]
            },
            "unit": "none"
          }
        }
      },
      {
        "id": 3,
        "title": "Latency comparison: push-down vs no-push-down",
        "type": "timeseries",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "targets": [
          {
            "expr": "histogram_quantile(0.99, rate(vector_search_latency_ms_bucket{pushdown=\"true\"}[5m]))",
            "legendFormat": "push-down p99"
          },
          {
            "expr": "histogram_quantile(0.99, rate(vector_search_latency_ms_bucket{pushdown=\"false\"}[5m]))",
            "legendFormat": "no push-down p99"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "mappings": [],
            "thresholds": {
              "steps": [
                {
                  "color": "green",
                  "value": 0
                },
                {
                  "color": "yellow",
                  "value": 50
                },
                {
                  "color": "red",
                  "value": 100
                }
              ]
            },
            "unit": "ms"
          }
        }
        "fieldConfig": {
          "defaults": {
            "mappings": [],
            "thresholds": {
              "steps": [
                {
                  "color": "green",
                  "value": 0
                },
                {
                  "color": "yellow",
                  "value": 10
                },
                {
                  "color": "red",
                  "value": 100
                }
              ]
            },
            "unit": "1/s"
          }
        }
      },
      {
        "id": 4,
        "title": "Too-Large Rejections",
        "type": "stat",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "targets": [
          {
            "expr": "rate(qdrant_pushdown_rate_total{result=\"too_large\"}[5m])",
            "legendFormat": "Rejections due to size"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "mappings": [],
            "thresholds": {
              "steps": [
                {
                  "color": "green",
                  "value": 0
                },
                {
                  "color": "yellow",
                  "value": 1
                },
                {
                  "color": "red",
                  "value": 10
                }
              ]
            },
            "unit": "1/s"
          }
        }
      }
    ],
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "refresh": "30s"
  }
}